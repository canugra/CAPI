APP_ENV=development
APP_URL=http://localhost:5000
DATABASE_URL=sqlite:///quickmeal.db

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret

# Meta Configuration (Placeholders)
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
# System
PORT=5000
SESSION_SECRET=your_super_secret_string

# Database (TiDB/MySQL)
DATABASE_URL="mysql+pymysql://<user>:<password>@gateway01...:4000/<database>"

# Meta WhatsApp Config
META_WABA_ID=123456789
META_WHATSAPP_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=your_permanent_token
META_GRAPH_API_VERSION=v19.0

# Webhook Verification
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token

# Security
SESSION_SECRET=super_secret_session_key
ENCRYPTION_KEY=
